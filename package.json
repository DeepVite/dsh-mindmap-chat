{
  "name": "dsh-mindmap-chat",
  "version": "0.2.2",
  "description": "Chat branch tree plugin for DeepSeek Harness: mind-map of conversation branches, plus a project kanban home for session management.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mindmap",
    "branch",
    "chat-tree",
    "conversation",
    "cordis"
  ],
  "author": "DeepVite <ibronfree@gmail.com>",
  "homepage": "https://github.com/DeepVite/dsh-mindmap-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepVite/dsh-mindmap-chat.git"
  },
  "bugs": {
    "url": "https://github.com/DeepVite/dsh-mindmap-chat/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./host": "./lib/host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*"
  },
  "license": "Apache-2.0"
}
