{
  "name": "dsh-mindmap-chat",
  "version": "0.1.1",
  "description": "Chat branch tree plugin for DeepSeek Harness: mind-map of conversation branches, group folders, archiving and compaction preview.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mindmap",
    "branch",
    "chat-tree",
    "conversation",
    "cordis"
  ],
  "author": "DeepVite <ibronfree@gmail.com>",
  "homepage": "https://github.com/DeepVite/dsh-mindmap-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepVite/dsh-mindmap-chat.git"
  },
  "bugs": {
    "url": "https://github.com/DeepVite/dsh-mindmap-chat/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "main": "lib/client.js",
  "exports": {
    ".": "./lib/client.js",
    "./host": "./lib/host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "design",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "Apache-2.0"
}
